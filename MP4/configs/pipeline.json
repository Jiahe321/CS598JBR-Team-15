{
  "toolchain": "nightly-2025-05-13",
  "max_iterations": 10,
  "max_total_tokens": 750000,
  "max_llm_requests_per_run": 80,
  "max_invalid_path_actions": 2,
  "stall_rounds": 3,
  "tester_rounds": 1,
  "phase_b_rounds": 4,
  "agent_max_steps": {"reader": 12, "writer": 15, "tester": 8},
  "reader_initial_max_steps": 10,
  "reader_focus_max_steps": 4,
  "reader_initial_read_limit": 18,
  "reader_focus_read_limit": 4,
  "writer_initial_read_limit": 12,
  "writer_repair_read_limit": 16,
  "max_actions_per_reply": 8,
  "obs_limit_chars": 6000,
  "history_keep": 8,
  "cargo_timeout_seconds": 600,
  "cargo_test_timeout_seconds": 90,
  "oracle_timeout_seconds": 20,
  "protected_globs": ["src/bin/*", "Cargo.toml"],
  "protected_exceptions": ["tests/extra_*.rs"],
  "unsafe_metrics_cmd": null,
  "unsafe_metrics_every_iteration": true,
  "c_compiler": "cc"
}
