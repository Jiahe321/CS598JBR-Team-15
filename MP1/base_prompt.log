        return 0
    else:
        return (n % 10) * digits(n // 10)


def digits_iter(n):
    """Given a positive integer n, return the product of the odd digits.
    Return  if all digits are even.
    For example:
    digits(1)  == 1
    digits(4)  == 0
    digits(235) == 15
    """
    if n == 0:
        return 0
    else:
        product = 1
        while n > 0:
            if n % 2 == 1:
                product *= n % 10
            n //= 10
        return product


