def encode_rail_fence(s: str, n: int):
    """
    returns encoded string by encoding it with rail fence cipher.
    """
    if n == 1:
        return s
    rail = [[] for _ in range(n)]
    dir_down = False
    row = 0
    for i in range(len(s)):
        rail[row].append(s[i])
        if row == 0 or row == n - 1:
            dir_down = not dir_down
        row += 1 if dir_down else -1
    return "".join(["".join(row) for row in rail])


