            int val = (int) s.chars()
                .filter(Character::isUpperCase)
                .count() - (int) s.chars()
                .filter(Character::isLowerCase)
                .count();
            if (val > my_val) {
                strong = s;
                my_val = val;
            }
        }

        String ans = class_name + "." + strong;
        return ans;
    }
}
