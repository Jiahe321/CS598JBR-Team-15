import java.util.*;

class Solution {
    public List<Integer> strangeSortList(List<Integer> lst) {
        List<Integer> res = new ArrayList<>();
        boolean switchVal = true;
        while (!lst.isEmpty()) {
            int minVal = Collections.min(lst);
            int maxVal = Collections.max(lst);
            if (switchVal) {
                res.add(minVal);
                lst.remove(Integer.valueOf(minVal));
            } else {
                res.add(maxVal);
                lst.remove(Integer.valueOf(maxVal));
            }
            switchVal = !switchVal;
        }
        return res;
    }
}
