import java.util.*;

class Solution {
    public String encodeShift(String s) {
        StringBuilder encoded = new StringBuilder();
        for (char ch : s.toCharArray()) {
            encoded.append((char)(((ch - 'a' + 5) % 26) + 'a'));
        }
        return encoded.toString();
    }

